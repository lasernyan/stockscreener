// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// AUDUSD 4H EMA Crossover + RSI + BB Strategy (v2)
// 7 Improvements: BB Bounce, Relaxed BE, Wide Trail, Tight RSI,
//                 MACD Confirm, ATR Vol Filter, Partial Close

//@version=5
strategy("AUDUSD 4H EMA+RSI+BB v2", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=2, initial_capital=100000, currency=currency.USD, pyramiding=0, calc_on_every_tick=false, commission_type=strategy.commission.cash_per_order, commission_value=0)

// ══════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════

emaFastLen   = input.int(20,    "EMA Fast Period",            group="EMA Crossover")
emaSlowLen   = input.int(50,    "EMA Slow Period",            group="EMA Crossover")

useRSI       = input.bool(true, "Use RSI Filter",             group="RSI")
rsiPeriod    = input.int(14,    "RSI Period",                 group="RSI")
rsiLongMax   = input.float(55,  "RSI Long Max (<)",           group="RSI")
rsiShortMin  = input.float(45,  "RSI Short Min (>)",          group="RSI")

useBB        = input.bool(true, "Use BB Entry",               group="Bollinger Bands")
useBBBounce  = input.bool(true, "Require BB Bounce",          group="Bollinger Bands")
bbPeriod     = input.int(20,    "BB Period",                  group="Bollinger Bands")
bbStdDev     = input.float(2.0, "BB Std Dev",                 group="Bollinger Bands")

atrPeriod    = input.int(14,    "ATR Period",                 group="ATR")
atrSLMult    = input.float(1.5, "ATR SL Multiplier",         group="ATR")
atrTPMult    = input.float(3.0, "ATR TP Multiplier",         group="ATR")

useTrail     = input.bool(true, "Use Trailing Stop",          group="Trailing Stop")
trailActATR  = input.float(1.5, "Trail Activation (ATR x)",  group="Trailing Stop")
trailDistATR = input.float(2.0, "Trail Distance (ATR x)",    group="Trailing Stop")

useBE        = input.bool(true, "Use Breakeven Stop",         group="Breakeven")
beATR        = input.float(2.0, "Breakeven ATR Mult",         group="Breakeven")

cooldownBars = input.int(3,     "Cooldown Bars after SL",     group="Cooldown", minval=0)

useADX       = input.bool(true, "Use ADX Filter",             group="ADX")
adxPeriod    = input.int(14,    "ADX Period",                 group="ADX")
adxThreshold = input.float(20,  "ADX Threshold",              group="ADX")

useTrend200  = input.bool(true, "Use 200 EMA Filter",         group="Trend Filter")
trendMAPeriod = input.int(200,  "Trend MA Period",             group="Trend Filter")

useMACD      = input.bool(true, "Use MACD Filter",            group="MACD")
macdFast     = input.int(12,    "MACD Fast",                  group="MACD")
macdSlow     = input.int(26,    "MACD Slow",                  group="MACD")
macdSignal   = input.int(9,     "MACD Signal",                group="MACD")

useATRFilter = input.bool(true, "Use ATR Vol Filter",         group="ATR Filter")
atrLookback  = input.int(200,   "ATR Lookback",               group="ATR Filter")
atrPctMin    = input.float(25,  "ATR Percentile Min",         group="ATR Filter")

usePartial   = input.bool(true, "Use Partial Close",          group="Partial Close")
partialATR   = input.float(1.5, "Partial Close ATR Mult",    group="Partial Close")
partialPct   = input.float(50,  "Partial Close %",            group="Partial Close")

showSignals  = input.bool(true, "Show Entry Signals",         group="Display")
showSLTP     = input.bool(true, "Show SL/TP Lines",           group="Display")

// ══════════════════════════════════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════════════════════════════════

emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
uptrend   = emaFast > emaSlow
downtrend = emaFast < emaSlow

rsiVal = ta.rsi(close, rsiPeriod)

bbMid   = ta.sma(close, bbPeriod)
bbDev   = ta.stdev(close, bbPeriod)
bbUpper = bbMid + bbStdDev * bbDev
bbLower = bbMid - bbStdDev * bbDev

atrVal = ta.atr(atrPeriod)

ema200 = ta.ema(close, trendMAPeriod)

[diPlus, diMinus, adxVal] = ta.dmi(adxPeriod, adxPeriod)

[macdLine, macdSig, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)

// ATR Percentile (#6): rank current ATR vs lookback
atrPctRank() =>
    cnt = 0
    for j = 1 to atrLookback
        if atrVal > nz(atrVal[j])
            cnt += 1
    float(cnt) / float(atrLookback) * 100.0

atrPercentileOk = useATRFilter ? atrPctRank() >= atrPctMin : true

// ══════════════════════════════════════════════════════════════════════
// ENTRY SIGNALS
// ══════════════════════════════════════════════════════════════════════

// BB Entry Trigger
var bool longTrigger  = false
var bool shortTrigger = false

prevTouchedLower = low[1] <= nz(bbLower[1])
bouncedUp        = close > bbLower
prevTouchedUpper = high[1] >= nz(bbUpper[1])
bouncedDown      = close < bbUpper

if useBB and useBBBounce
    longTrigger  := prevTouchedLower and bouncedUp
    shortTrigger := prevTouchedUpper and bouncedDown
else if useBB
    longTrigger  := low <= bbLower
    shortTrigger := high >= bbUpper
else
    longTrigger  := ta.crossover(emaFast, emaSlow)
    shortTrigger := ta.crossunder(emaFast, emaSlow)

// Combine all filters
longSignal  = uptrend and longTrigger
shortSignal = downtrend and shortTrigger

longSignal  := useRSI ? longSignal and (rsiVal < rsiLongMax) : longSignal
shortSignal := useRSI ? shortSignal and (rsiVal > rsiShortMin) : shortSignal

longSignal  := useTrend200 ? longSignal and (close > ema200) : longSignal
shortSignal := useTrend200 ? shortSignal and (close < ema200) : shortSignal

longSignal  := useADX ? longSignal and (adxVal > adxThreshold) : longSignal
shortSignal := useADX ? shortSignal and (adxVal > adxThreshold) : shortSignal

// MACD filter (#5)
macdBullish = macdHist > 0 or macdHist > nz(macdHist[1])
macdBearish = macdHist < 0 or macdHist < nz(macdHist[1])
longSignal  := useMACD ? longSignal and macdBullish : longSignal
shortSignal := useMACD ? shortSignal and macdBearish : shortSignal

// ATR volatility filter (#6)
longSignal  := useATRFilter ? longSignal and atrPercentileOk : longSignal
shortSignal := useATRFilter ? shortSignal and atrPercentileOk : shortSignal

// ══════════════════════════════════════════════════════════════════════
// POSITION MANAGEMENT STATE
// ══════════════════════════════════════════════════════════════════════

var float entryPrice     = na
var float slPrice        = na
var float tpPrice        = na
var float bestPrice      = na
var float entryATR       = na
var bool  trailActive    = false
var bool  breakEvenHit   = false
var bool  partialClosed  = false
var int   cooldownCount  = 0
var int   posDir         = 0

if cooldownCount > 0
    cooldownCount := cooldownCount - 1

isLong  = strategy.position_size > 0
isShort = strategy.position_size < 0
isFlat  = strategy.position_size == 0

// ══════════════════════════════════════════════════════════════════════
// LONG MANAGEMENT
// ══════════════════════════════════════════════════════════════════════

if isLong and posDir == 1
    if high > bestPrice
        bestPrice := high

    // #7: Partial close
    if usePartial and not partialClosed and bestPrice >= entryPrice + partialATR * entryATR
        strategy.close("Long", comment="Partial TP", qty_percent=partialPct)
        partialClosed := true

    // #2: Breakeven
    if useBE and not breakEvenHit and bestPrice >= entryPrice + beATR * entryATR
        slPrice      := entryPrice
        breakEvenHit := true

    // #3: Trailing stop
    if useTrail and trailActive
        newTrailSL = bestPrice - trailDistATR * entryATR
        if newTrailSL > slPrice
            slPrice := newTrailSL
    else if useTrail and not trailActive and bestPrice >= entryPrice + trailActATR * entryATR
        trailActive := true
        newTrailSL2 = bestPrice - trailDistATR * entryATR
        if newTrailSL2 > slPrice
            slPrice := newTrailSL2

    // Check SL hit
    if low <= slPrice
        exitLabel = trailActive ? "TSL" : breakEvenHit ? "BE" : "SL"
        strategy.close("Long", comment=exitLabel)
        if not trailActive and not breakEvenHit
            cooldownCount := cooldownBars
        posDir := 0

// ══════════════════════════════════════════════════════════════════════
// SHORT MANAGEMENT
// ══════════════════════════════════════════════════════════════════════

if isShort and posDir == -1
    if low < bestPrice
        bestPrice := low

    // #7: Partial close
    if usePartial and not partialClosed and bestPrice <= entryPrice - partialATR * entryATR
        strategy.close("Short", comment="Partial TP", qty_percent=partialPct)
        partialClosed := true

    // #2: Breakeven
    if useBE and not breakEvenHit and bestPrice <= entryPrice - beATR * entryATR
        slPrice      := entryPrice
        breakEvenHit := true

    // #3: Trailing stop
    if useTrail and trailActive
        newTrailSL = bestPrice + trailDistATR * entryATR
        if newTrailSL < slPrice
            slPrice := newTrailSL
    else if useTrail and not trailActive and bestPrice <= entryPrice - trailActATR * entryATR
        trailActive := true
        newTrailSL2 = bestPrice + trailDistATR * entryATR
        if newTrailSL2 < slPrice
            slPrice := newTrailSL2

    // Check SL hit
    if high >= slPrice
        exitLabel = trailActive ? "TSL" : breakEvenHit ? "BE" : "SL"
        strategy.close("Short", comment=exitLabel)
        if not trailActive and not breakEvenHit
            cooldownCount := cooldownBars
        posDir := 0

// ══════════════════════════════════════════════════════════════════════
// ENTRY LOGIC
// ══════════════════════════════════════════════════════════════════════

if isFlat and cooldownCount == 0 and longSignal and atrVal > 0
    entryPrice    := close
    slPrice       := close - atrSLMult * atrVal
    tpPrice       := close + atrTPMult * atrVal
    bestPrice     := close
    entryATR      := atrVal
    trailActive   := false
    breakEvenHit  := false
    partialClosed := false
    posDir        := 1
    strategy.entry("Long", strategy.long, comment="Long")

else if isFlat and cooldownCount == 0 and shortSignal and atrVal > 0
    entryPrice    := close
    slPrice       := close + atrSLMult * atrVal
    tpPrice       := close - atrTPMult * atrVal
    bestPrice     := close
    entryATR      := atrVal
    trailActive   := false
    breakEvenHit  := false
    partialClosed := false
    posDir        := -1
    strategy.entry("Short", strategy.short, comment="Short")

// Reset state when position closed externally
if isFlat and posDir != 0
    posDir := 0

// ══════════════════════════════════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════════════════════════════════

plot(emaFast, "EMA Fast", color=color.blue, linewidth=1)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=1)
plot(ema200,  "EMA 200",  color=color.orange, linewidth=2)

p_bbUpper = plot(bbUpper, "BB Upper", color=color.gray, linewidth=1)
p_bbLower = plot(bbLower, "BB Lower", color=color.gray, linewidth=1)
fill(p_bbUpper, p_bbLower, color=color.new(color.blue, 95), title="BB Fill")

// SL/TP Lines
slPlot = showSLTP and posDir != 0 ? slPrice : na
tpPlot = showSLTP and posDir != 0 ? tpPrice : na
epPlot = showSLTP and posDir != 0 ? entryPrice : na
plot(slPlot, "Stop Loss", color=color.new(color.red, 30), style=plot.style_linebr, linewidth=2)
plot(tpPlot, "Take Profit", color=color.new(color.green, 30), style=plot.style_linebr, linewidth=2)
plot(epPlot, "Entry", color=color.new(color.white, 30), style=plot.style_linebr, linewidth=1)

// Entry Signals
longSigPlot  = showSignals and longSignal and isFlat and cooldownCount == 0
shortSigPlot = showSignals and shortSignal and isFlat and cooldownCount == 0
plotshape(longSigPlot, "Long Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(shortSigPlot, "Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// Partial Close marker
partialJustHit = usePartial and partialClosed and not partialClosed[1]
plotshape(partialJustHit, "Partial TP", style=shape.diamond, location=location.abovebar, color=color.orange, size=size.tiny)

// Background
bgcolor(cooldownCount > 0 ? color.new(color.red, 95) : na, title="Cooldown")
trendBG = uptrend ? color.new(color.green, 97) : downtrend ? color.new(color.red, 97) : na
bgcolor(trendBG, title="Trend BG")

// ══════════════════════════════════════════════════════════════════════
// INFO TABLE
// ══════════════════════════════════════════════════════════════════════

var table infoTable = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80))

if barstate.islast
    table.cell(infoTable, 0, 0, "Filter", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "Status", text_color=color.white, text_size=size.small)

    emaLabel = "EMA " + str.tostring(emaFastLen) + "/" + str.tostring(emaSlowLen)
    table.cell(infoTable, 0, 1, emaLabel, text_color=color.white, text_size=size.tiny)
    trendColor = uptrend ? color.green : color.red
    trendText  = uptrend ? "UP" : "DOWN"
    table.cell(infoTable, 1, 1, trendText, text_color=trendColor, text_size=size.tiny)

    table.cell(infoTable, 0, 2, "RSI", text_color=color.white, text_size=size.tiny)
    rsiColor = rsiVal < rsiLongMax ? color.green : color.red
    table.cell(infoTable, 1, 2, str.tostring(rsiVal, "#.0"), text_color=rsiColor, text_size=size.tiny)

    table.cell(infoTable, 0, 3, "ADX", text_color=color.white, text_size=size.tiny)
    adxColor = adxVal > adxThreshold ? color.green : color.gray
    table.cell(infoTable, 1, 3, str.tostring(adxVal, "#.0"), text_color=adxColor, text_size=size.tiny)

    table.cell(infoTable, 0, 4, "MACD Hist", text_color=color.white, text_size=size.tiny)
    macdColor = macdHist > 0 ? color.green : color.red
    table.cell(infoTable, 1, 4, str.tostring(macdHist, "#.00000"), text_color=macdColor, text_size=size.tiny)

    table.cell(infoTable, 0, 5, "ATR (pips)", text_color=color.white, text_size=size.tiny)
    atrColor = atrPercentileOk ? color.green : color.gray
    table.cell(infoTable, 1, 5, str.tostring(atrVal * 10000, "#.0"), text_color=atrColor, text_size=size.tiny)

    table.cell(infoTable, 0, 6, "EMA 200", text_color=color.white, text_size=size.tiny)
    ema200Color = close > ema200 ? color.green : color.red
    ema200Text  = close > ema200 ? "ABOVE" : "BELOW"
    table.cell(infoTable, 1, 6, ema200Text, text_color=ema200Color, text_size=size.tiny)

    table.cell(infoTable, 0, 7, "Position", text_color=color.white, text_size=size.tiny)
    posText  = posDir == 1 ? "LONG" : posDir == -1 ? "SHORT" : "FLAT"
    posColor = posDir == 1 ? color.green : posDir == -1 ? color.red : color.gray
    table.cell(infoTable, 1, 7, posText, text_color=posColor, text_size=size.tiny)

    table.cell(infoTable, 0, 8, "Trail", text_color=color.white, text_size=size.tiny)
    trailText  = trailActive ? "ACTIVE" : "---"
    trailColor = trailActive ? color.orange : color.gray
    table.cell(infoTable, 1, 8, trailText, text_color=trailColor, text_size=size.tiny)

    table.cell(infoTable, 0, 9, "Breakeven", text_color=color.white, text_size=size.tiny)
    beText  = breakEvenHit ? "HIT" : "---"
    beColor = breakEvenHit ? color.green : color.gray
    table.cell(infoTable, 1, 9, beText, text_color=beColor, text_size=size.tiny)

    table.cell(infoTable, 0, 10, "Cooldown", text_color=color.white, text_size=size.tiny)
    cdColor = cooldownCount > 0 ? color.red : color.gray
    table.cell(infoTable, 1, 10, str.tostring(cooldownCount), text_color=cdColor, text_size=size.tiny)

    table.cell(infoTable, 0, 11, "Partial", text_color=color.white, text_size=size.tiny)
    partColor = partialClosed ? color.orange : color.gray
    partText  = partialClosed ? "DONE" : "---"
    table.cell(infoTable, 1, 11, partText, text_color=partColor, text_size=size.tiny)

// ══════════════════════════════════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════════════════════════════════

alertcondition(longSignal and isFlat and cooldownCount == 0, "Long Entry", "AUDUSD 4H: Long signal confirmed")
alertcondition(shortSignal and isFlat and cooldownCount == 0, "Short Entry", "AUDUSD 4H: Short signal confirmed")
alertcondition(isLong and low <= slPrice and posDir == 1, "Long SL Hit", "AUDUSD 4H: Long stop-loss triggered")
alertcondition(isShort and high >= slPrice and posDir == -1, "Short SL Hit", "AUDUSD 4H: Short stop-loss triggered")
