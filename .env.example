# ============================================================
# 環境変数テンプレート
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env
#
# .env は .gitignore に含まれているため Git にコミットされません。
# ============================================================

# ============================================================
# 分析モード選択
# ============================================================
# USE_COWORK=1 (推奨): Claude Code Agent SDK を使用
#   → Pro/Max サブスクリプション消費 / APIキー不要
#   → 要: pip install claude-agent-sdk + Claude Code CLI ログイン済み
USE_COWORK=1

# USE_COWORK=0 かつ RUN_AI=1: Anthropic API を直接使用
#   → トークン課金 (~$0.20/回) / APIキーが必要
RUN_AI=0

# Anthropic API キー (RUN_AI=1 のときのみ必要)
# 取得: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# daily_runner.sh の実行設定
# ============================================================
# データ取得を有効化 (1=ON / 0=OFF)
RUN_FETCH=1

# バックテストを有効化
RUN_BACKTEST=1

# 取得するマーケット (ETF / BOND / COMMODITY / CRYPTO / FX / ALL)
MARKET_FETCH=ALL
