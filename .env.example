# ============================================================
# 環境変数テンプレート
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env
#
# .env は .gitignore に含まれているため Git にコミットされません。
# ============================================================

# Anthropic API キー (claude_analyst.py の AI 分析に必須)
# 取得: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# daily_runner.sh の実行設定 (任意)
# ============================================================
# データ取得を有効化 (1=ON / 0=OFF)
RUN_FETCH=1

# バックテストを有効化
RUN_BACKTEST=1

# Claude AI 分析を有効化 (ANTHROPIC_API_KEY が必要)
RUN_AI=1

# 取得するマーケット (ETF / BOND / COMMODITY / CRYPTO / FX / ALL)
MARKET_FETCH=ALL
