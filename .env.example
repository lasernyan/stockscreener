# xAI API Key (optional)
# Get your key at https://console.x.ai/
# XAI_API_KEY=your_xai_api_key_here

# Optional: API base URL (default: https://api.x.ai)
# XAI_BASE_URL=https://api.x.ai

# Optional: Model (default: grok-4-1-fast-reasoning)
# XAI_MODEL=grok-4-1-fast-reasoning

# =============================================================================
# Sector Rotation & Fund Flow Analyzer — API Keys
# =============================================================================

# EDINET API (金融庁 EDINET API v2)
# 公開買付・大量保有報告書・自社株買いイベントの取得に使用
# 登録: https://disclosure2dl.edinet-api.go.jp/guide/static/disclosure/REVISION_01/index.html
# EDINET_API_KEY=your_edinet_subscription_key_here

# e-STAT API (政府統計の総合窓口)
# 景気動向指数・鉱工業生産指数・CPI などマクロ経済データの取得に使用
# 登録: https://www.e-stat.go.jp/api/
# ESTAT_APP_ID=your_estat_app_id_here
