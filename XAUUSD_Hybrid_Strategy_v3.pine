// This Pine Script(TM) v6 indicator/strategy is subject to the Terms of Use:
// https://www.tradingview.com/pine-script-docs/
// XAUUSD Hybrid Strategy v3
// =========================
// Dual-engine strategy combining:
//   ENGINE 1 — Breakout: Donchian channel break (tight trail, quick capture)
//   ENGINE 2 — Trend Follow: EMA crossover + pullback (wide trail, ride trends)
//
// Each engine has independent trailing stops:
//   - Breakout:     tight trail for quick profit capture
//   - Trend Follow: wide trail to ride extended gold trends
//
// Shared infrastructure:
//   - Risk-based position sizing
//   - Session filter (avoid Asian session)
//   - ADX regime filter
//   - Daily loss limit
//   - SL cooldown (per-engine)

//@version=6
strategy("XAUUSD Hybrid v3", overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.cash,
     default_qty_value=100000,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     slippage=50,
     calc_on_every_tick=false,
     pyramiding=2)  // Allow 1 breakout + 1 trend position simultaneously


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                              INPUTS                                     │
// └─────────────────────────────────────────────────────────────────────────┘

// ── Engine Enable ────────────────────────────────────────────────────────
grp_eng = "Engine Enable"
useBreakoutEngine    = input.bool(true, "Enable Breakout Engine", group=grp_eng)
useTrendFollowEngine = input.bool(true, "Enable Trend-Follow Engine", group=grp_eng)

// ── Breakout Engine ──────────────────────────────────────────────────────
grp_bo = "Breakout Engine"
boLookback        = input.int(20, "Channel Lookback", minval=5, maxval=100, group=grp_bo)
boSlMult          = input.float(1.5, "SL Multiplier (ATR)", minval=0.5, maxval=5.0, step=0.1, group=grp_bo)
boTpMult          = input.float(3.0, "TP Multiplier (ATR)", minval=1.0, maxval=10.0, step=0.1, group=grp_bo,
                        tooltip="Used only when breakout trailing stop is disabled")
boUseTrail        = input.bool(true, "Enable Trailing Stop", group=grp_bo)
boTrailActivation = input.float(1.5, "Trail Activation (ATR)", minval=0.5, maxval=5.0, step=0.1, group=grp_bo)
boTrailDistance   = input.float(2.0, "Trail Distance (ATR)", minval=0.5, maxval=5.0, step=0.1, group=grp_bo,
                        tooltip="Tight trail — capture breakout momentum quickly")
boBreakevenATR    = input.float(1.0, "Breakeven Trigger (ATR)", minval=0.5, maxval=5.0, step=0.1, group=grp_bo)
boMomentumThresh  = input.float(0.3, "Breakout Strength (ATR ratio)", minval=0.05, maxval=1.0, step=0.05, group=grp_bo)

// ── Trend-Follow Engine ──────────────────────────────────────────────────
grp_tf = "Trend-Follow Engine"
tfFastMa         = input.int(50, "Fast EMA Period", minval=10, maxval=100, group=grp_tf)
tfSlowMa         = input.int(200, "Slow EMA Period", minval=100, maxval=500, group=grp_tf)
tfPullbackMa     = input.int(50, "Pullback MA (entry zone)", minval=10, maxval=100, group=grp_tf,
                       tooltip="Enter when price pulls back to this EMA in the direction of the trend")
tfSlMult         = input.float(2.0, "SL Multiplier (ATR)", minval=0.5, maxval=5.0, step=0.1, group=grp_tf)
tfUseTrail       = input.bool(true, "Enable Trailing Stop", group=grp_tf)
tfTrailActivation = input.float(2.5, "Trail Activation (ATR)", minval=0.5, maxval=8.0, step=0.1, group=grp_tf)
tfTrailDistance  = input.float(4.0, "Trail Distance (ATR)", minval=1.0, maxval=8.0, step=0.1, group=grp_tf,
                       tooltip="Wide trail — designed to ride extended gold trends")
tfBreakevenATR   = input.float(2.0, "Breakeven Trigger (ATR)", minval=0.5, maxval=5.0, step=0.1, group=grp_tf)
tfTpMult         = input.float(6.0, "TP Multiplier (ATR)", minval=2.0, maxval=15.0, step=0.5, group=grp_tf,
                       tooltip="Used only when trend trailing stop is disabled")
tfPullbackATR    = input.float(0.5, "Max Pullback Depth (ATR)", minval=0.1, maxval=2.0, step=0.1, group=grp_tf,
                       tooltip="Price must be within this ATR distance of pullback MA")

// ── Shared: ATR / ADX ───────────────────────────────────────────────────
grp_shared = "Shared Indicators"
atrPeriod      = input.int(14, "ATR Period", minval=1, maxval=50, group=grp_shared)
useAdxFilter   = input.bool(true, "Enable ADX Filter", group=grp_shared)
adxPeriod      = input.int(14, "ADX Period", minval=5, maxval=50, group=grp_shared)
adxThreshold   = input.int(20, "ADX Threshold", minval=10, maxval=50, group=grp_shared)
adxRequireRise = input.bool(true, "Require ADX Rising", group=grp_shared)

// ── Shared: Risk Management ─────────────────────────────────────────────
grp_risk = "Risk Management"
riskPercentBO  = input.float(1.0, "Risk Per Breakout Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_risk)
riskPercentTF  = input.float(1.0, "Risk Per Trend Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_risk)
maxDailyLoss   = input.float(3.0, "Max Daily Loss (%)", minval=1.0, maxval=10.0, step=0.5, group=grp_risk)

// ── Shared: Session Filter ──────────────────────────────────────────────
grp_session = "Session Filter"
useSessionFilter = input.bool(true, "Enable Session Filter", group=grp_session)
sessionStart     = input.int(7, "Session Start (UTC Hour)", minval=0, maxval=23, group=grp_session)
sessionEnd       = input.int(20, "Session End (UTC Hour)", minval=0, maxval=23, group=grp_session)

// ── Shared: Cooldown ────────────────────────────────────────────────────
grp_cd = "Cooldown"
cooldownBars = input.int(5, "Cooldown Bars After SL", minval=0, maxval=20, group=grp_cd)

// ── Shared: Direction ───────────────────────────────────────────────────
grp_dir = "Direction Bias"
longOnly = input.bool(false, "Long Only (No Shorts)", group=grp_dir)


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                         INDICATOR CALCULATIONS                          │
// └─────────────────────────────────────────────────────────────────────────┘

// ATR
atrValue = ta.atr(atrPeriod)

// ADX
[diPlus, diMinus, adxValue] = ta.dmi(adxPeriod, adxPeriod)
adxDirectionOk = adxRequireRise ? adxValue > adxValue[3] : true
adxOk = useAdxFilter ? (adxValue > adxThreshold and adxDirectionOk) : true

// Session
currentHour = hour(time, "UTC")
inSession = useSessionFilter ? (sessionStart < sessionEnd ?
             (currentHour >= sessionStart and currentHour < sessionEnd) :
             (currentHour >= sessionStart or currentHour < sessionEnd)) : true

// ── Breakout Engine indicators ───────────────────────────────────────────
upperChannel = ta.highest(high, boLookback)[1]
lowerChannel = ta.lowest(low, boLookback)[1]

// ── Trend-Follow Engine indicators ───────────────────────────────────────
emaFast     = ta.ema(close, tfFastMa)
emaSlow     = ta.ema(close, tfSlowMa)
emaPullback = ta.ema(close, tfPullbackMa)

// Trend direction
trendUp   = emaFast > emaSlow
trendDown = emaFast < emaSlow

// Trend just established (crossover within last N bars for initial entry)
trendUpEstablished  = trendUp  and trendUp[1]   // stable uptrend (not just crossed)
trendDownEstablished = trendDown and trendDown[1]

// Pullback detection: price touches/approaches the pullback EMA
longPullback  = low <= emaPullback + tfPullbackATR * atrValue and close > emaPullback
shortPullback = high >= emaPullback - tfPullbackATR * atrValue and close < emaPullback

// Pullback confirmation: current bar bounces (closes in trend direction)
longBounce  = close > open and close > emaPullback
shortBounce = close < open and close < emaPullback

// Volume
volSma = ta.sma(volume, 20)


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                         SIGNAL GENERATION                               │
// └─────────────────────────────────────────────────────────────────────────┘

// ── Breakout signals ─────────────────────────────────────────────────────
boBaseLong  = close > upperChannel
boBaseShort = close < lowerChannel

boLongStrength  = boBaseLong  ? (close - upperChannel) / atrValue : 0.0
boShortStrength = boBaseShort ? (lowerChannel - close) / atrValue : 0.0

boLongSignal  = useBreakoutEngine and boBaseLong  and boLongStrength > boMomentumThresh
                and adxOk and inSession
boShortSignal = useBreakoutEngine and boBaseShort and boShortStrength > boMomentumThresh
                and adxOk and inSession and not longOnly

// ── Trend-Follow signals ─────────────────────────────────────────────────
// Long: stable uptrend + pullback to fast EMA + bounce + price above slow EMA
tfLongSignal  = useTrendFollowEngine and trendUpEstablished
                and longPullback and longBounce
                and close > emaSlow
                and adxOk and inSession

// Short: stable downtrend + pullback to fast EMA + bounce down + price below slow EMA
tfShortSignal = useTrendFollowEngine and trendDownEstablished
                and shortPullback and shortBounce
                and close < emaSlow
                and adxOk and inSession and not longOnly


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                      STATE VARIABLES (per-engine)                       │
// └─────────────────────────────────────────────────────────────────────────┘

// ── Breakout engine state ────────────────────────────────────────────────
var float boEntryPrice    = na
var float boCurrentSL     = na
var float boBestPrice     = na
var float boTrailATR      = na
var bool  boTrailActive   = false
var bool  boBEHit         = false
var bool  boEntrySet      = false
var bool  boHasPosition   = false
var int   boCooldown      = 0

// ── Trend-Follow engine state ────────────────────────────────────────────
var float tfEntryPrice    = na
var float tfCurrentSL     = na
var float tfBestPrice     = na
var float tfTrailATR      = na
var bool  tfTrailActive   = false
var bool  tfBEHit         = false
var bool  tfEntrySet      = false
var bool  tfHasPosition   = false
var int   tfCooldown      = 0

// ── Shared state ─────────────────────────────────────────────────────────
var float dailyPnL   = 0.0
var int   lastTradeDay = 0


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                         DAILY P&L TRACKING                              │
// └─────────────────────────────────────────────────────────────────────────┘

currentDay = dayofmonth(time)
if currentDay != lastTradeDay
    dailyPnL     := 0.0
    lastTradeDay := currentDay

if strategy.closedtrades > 0
    if strategy.closedtrades > strategy.closedtrades[1]
        dailyPnL := dailyPnL + strategy.closedtrades.profit(strategy.closedtrades - 1)

dailyLossLimitHit = dailyPnL <= -(strategy.equity * maxDailyLoss / 100)


// ┌─────────────────────────────────────────────────────────────────────────┐
// │               ENTRY PRICE CORRECTION (actual fill prices)               │
// └─────────────────────────────────────────────────────────────────────────┘

// Correct BO entry price on the bar after fill
if boHasPosition and not boEntrySet and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        if strategy.opentrades.entry_id(i) == "BO_Long" or strategy.opentrades.entry_id(i) == "BO_Short"
            boEntryPrice := strategy.opentrades.entry_price(i)
            slDist        = boSlMult * boTrailATR
            if strategy.opentrades.size(i) > 0
                boCurrentSL := boEntryPrice - slDist
            else
                boCurrentSL := boEntryPrice + slDist
            boBestPrice := boEntryPrice
            boEntrySet  := true
            break

// Correct TF entry price on the bar after fill
if tfHasPosition and not tfEntrySet and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        if strategy.opentrades.entry_id(i) == "TF_Long" or strategy.opentrades.entry_id(i) == "TF_Short"
            tfEntryPrice := strategy.opentrades.entry_price(i)
            slDist        = tfSlMult * tfTrailATR
            if strategy.opentrades.size(i) > 0
                tfCurrentSL := tfEntryPrice - slDist
            else
                tfCurrentSL := tfEntryPrice + slDist
            tfBestPrice := tfEntryPrice
            tfEntrySet  := true
            break


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                       COOLDOWN MANAGEMENT                               │
// └─────────────────────────────────────────────────────────────────────────┘

// Detect per-engine exits by checking if trade IDs disappeared
boStillOpen = false
tfStillOpen = false
if strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        eid = strategy.opentrades.entry_id(i)
        if eid == "BO_Long" or eid == "BO_Short"
            boStillOpen := true
        if eid == "TF_Long" or eid == "TF_Short"
            tfStillOpen := true

// BO exit detection
if boHasPosition and not boStillOpen
    // Check if it was a loss
    if strategy.closedtrades > 0
        lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
        lastId     = strategy.closedtrades.entry_id(strategy.closedtrades - 1)
        if (lastId == "BO_Long" or lastId == "BO_Short") and lastProfit < 0
            boCooldown := cooldownBars
    boHasPosition := false
    boEntrySet    := false
    boTrailActive := false
    boBEHit       := false

// TF exit detection
if tfHasPosition and not tfStillOpen
    if strategy.closedtrades > 0
        lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
        lastId     = strategy.closedtrades.entry_id(strategy.closedtrades - 1)
        if (lastId == "TF_Long" or lastId == "TF_Short") and lastProfit < 0
            tfCooldown := cooldownBars
    tfHasPosition := false
    tfEntrySet    := false
    tfTrailActive := false
    tfBEHit       := false

if boCooldown > 0
    boCooldown := boCooldown - 1
if tfCooldown > 0
    tfCooldown := tfCooldown - 1


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                         POSITION SIZING                                 │
// └─────────────────────────────────────────────────────────────────────────┘

boSlDist = boSlMult * atrValue
tfSlDist = tfSlMult * atrValue

boRiskAmt = strategy.equity * riskPercentBO / 100.0
tfRiskAmt = strategy.equity * riskPercentTF / 100.0

boQty = boSlDist > 0 ? boRiskAmt / boSlDist : 0
tfQty = tfSlDist > 0 ? tfRiskAmt / tfSlDist : 0


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                  ENTRY LOGIC — BREAKOUT ENGINE                          │
// └─────────────────────────────────────────────────────────────────────────┘

boCanEnter = not boHasPosition
             and boCooldown == 0
             and not na(atrValue) and atrValue > 0
             and not dailyLossLimitHit
             and boQty > 0

if boCanEnter and boLongSignal
    boEntryPrice  := close
    boCurrentSL   := close - boSlMult * atrValue
    boBestPrice   := close
    boTrailATR    := atrValue
    boTrailActive := false
    boBEHit       := false
    boEntrySet    := false
    boHasPosition := true
    strategy.entry("BO_Long", strategy.long, qty=boQty)

if boCanEnter and boShortSignal
    boEntryPrice  := close
    boCurrentSL   := close + boSlMult * atrValue
    boBestPrice   := close
    boTrailATR    := atrValue
    boTrailActive := false
    boBEHit       := false
    boEntrySet    := false
    boHasPosition := true
    strategy.entry("BO_Short", strategy.short, qty=boQty)


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                ENTRY LOGIC — TREND-FOLLOW ENGINE                        │
// └─────────────────────────────────────────────────────────────────────────┘

tfCanEnter = not tfHasPosition
             and tfCooldown == 0
             and not na(atrValue) and atrValue > 0
             and not dailyLossLimitHit
             and tfQty > 0

if tfCanEnter and tfLongSignal
    tfEntryPrice  := close
    tfCurrentSL   := close - tfSlMult * atrValue
    tfBestPrice   := close
    tfTrailATR    := atrValue
    tfTrailActive := false
    tfBEHit       := false
    tfEntrySet    := false
    tfHasPosition := true
    strategy.entry("TF_Long", strategy.long, qty=tfQty)

if tfCanEnter and tfShortSignal
    tfEntryPrice  := close
    tfCurrentSL   := close + tfSlMult * atrValue
    tfBestPrice   := close
    tfTrailATR    := atrValue
    tfTrailActive := false
    tfBEHit       := false
    tfEntrySet    := false
    tfHasPosition := true
    strategy.entry("TF_Short", strategy.short, qty=tfQty)


// ┌─────────────────────────────────────────────────────────────────────────┐
// │       POSITION MANAGEMENT — BREAKOUT ENGINE (tight trailing)            │
// └─────────────────────────────────────────────────────────────────────────┘

if boHasPosition and boStillOpen
    // Determine direction from entry ID
    boIsLong = false
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == "BO_Long"
                boIsLong := true
                break

    if boIsLong
        boBestPrice := math.max(nz(boBestPrice), high)

        // Breakeven
        if not boBEHit and boBestPrice >= boEntryPrice + boBreakevenATR * boTrailATR
            boCurrentSL := math.max(nz(boCurrentSL), boEntryPrice)
            boBEHit     := true

        // Trailing (tight)
        if boUseTrail
            if boTrailActive
                trailSL     = boBestPrice - boTrailDistance * boTrailATR
                boCurrentSL := math.max(nz(boCurrentSL), trailSL)
            else if boBestPrice >= boEntryPrice + boTrailActivation * boTrailATR
                boTrailActive := true
                trailSL       = boBestPrice - boTrailDistance * boTrailATR
                boCurrentSL   := math.max(nz(boCurrentSL), trailSL)

        if boUseTrail
            strategy.exit("Exit BO_Long", "BO_Long", stop=boCurrentSL)
        else
            boTpPrice = boEntryPrice + boTpMult * boTrailATR
            strategy.exit("Exit BO_Long", "BO_Long", stop=boCurrentSL, limit=boTpPrice)

    else  // BO Short
        boBestPrice := math.min(nz(boBestPrice, close + 9999), low)

        if not boBEHit and boBestPrice <= boEntryPrice - boBreakevenATR * boTrailATR
            boCurrentSL := math.min(nz(boCurrentSL, close + 9999), boEntryPrice)
            boBEHit     := true

        if boUseTrail
            if boTrailActive
                trailSL     = boBestPrice + boTrailDistance * boTrailATR
                boCurrentSL := math.min(nz(boCurrentSL, close + 9999), trailSL)
            else if boBestPrice <= boEntryPrice - boTrailActivation * boTrailATR
                boTrailActive := true
                trailSL       = boBestPrice + boTrailDistance * boTrailATR
                boCurrentSL   := math.min(nz(boCurrentSL, close + 9999), trailSL)

        if boUseTrail
            strategy.exit("Exit BO_Short", "BO_Short", stop=boCurrentSL)
        else
            boTpPrice = boEntryPrice - boTpMult * boTrailATR
            strategy.exit("Exit BO_Short", "BO_Short", stop=boCurrentSL, limit=boTpPrice)


// ┌─────────────────────────────────────────────────────────────────────────┐
// │      POSITION MANAGEMENT — TREND-FOLLOW ENGINE (wide trailing)          │
// └─────────────────────────────────────────────────────────────────────────┘

if tfHasPosition and tfStillOpen
    tfIsLong = false
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == "TF_Long"
                tfIsLong := true
                break

    if tfIsLong
        tfBestPrice := math.max(nz(tfBestPrice), high)

        // Breakeven
        if not tfBEHit and tfBestPrice >= tfEntryPrice + tfBreakevenATR * tfTrailATR
            tfCurrentSL := math.max(nz(tfCurrentSL), tfEntryPrice)
            tfBEHit     := true

        // Trailing (wide — ride the trend)
        if tfUseTrail
            if tfTrailActive
                trailSL     = tfBestPrice - tfTrailDistance * tfTrailATR
                tfCurrentSL := math.max(nz(tfCurrentSL), trailSL)
            else if tfBestPrice >= tfEntryPrice + tfTrailActivation * tfTrailATR
                tfTrailActive := true
                trailSL       = tfBestPrice - tfTrailDistance * tfTrailATR
                tfCurrentSL   := math.max(nz(tfCurrentSL), trailSL)

        // Trend invalidation: if fast EMA crosses below slow EMA, tighten SL
        if not trendUp
            emergencySL = tfBestPrice - boTrailDistance * tfTrailATR  // tighten to breakout-level distance
            tfCurrentSL := math.max(nz(tfCurrentSL), emergencySL)

        if tfUseTrail
            strategy.exit("Exit TF_Long", "TF_Long", stop=tfCurrentSL)
        else
            tfTpPrice = tfEntryPrice + tfTpMult * tfTrailATR
            strategy.exit("Exit TF_Long", "TF_Long", stop=tfCurrentSL, limit=tfTpPrice)

    else  // TF Short
        tfBestPrice := math.min(nz(tfBestPrice, close + 9999), low)

        if not tfBEHit and tfBestPrice <= tfEntryPrice - tfBreakevenATR * tfTrailATR
            tfCurrentSL := math.min(nz(tfCurrentSL, close + 9999), tfEntryPrice)
            tfBEHit     := true

        if tfUseTrail
            if tfTrailActive
                trailSL     = tfBestPrice + tfTrailDistance * tfTrailATR
                tfCurrentSL := math.min(nz(tfCurrentSL, close + 9999), trailSL)
            else if tfBestPrice <= tfEntryPrice - tfTrailActivation * tfTrailATR
                tfTrailActive := true
                trailSL       = tfBestPrice + tfTrailDistance * tfTrailATR
                tfCurrentSL   := math.min(nz(tfCurrentSL, close + 9999), trailSL)

        // Trend invalidation for shorts
        if not trendDown
            emergencySL = tfBestPrice + boTrailDistance * tfTrailATR
            tfCurrentSL := math.min(nz(tfCurrentSL, close + 9999), emergencySL)

        if tfUseTrail
            strategy.exit("Exit TF_Short", "TF_Short", stop=tfCurrentSL)
        else
            tfTpPrice = tfEntryPrice - tfTpMult * tfTrailATR
            strategy.exit("Exit TF_Short", "TF_Short", stop=tfCurrentSL, limit=tfTpPrice)


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                              PLOTS                                      │
// └─────────────────────────────────────────────────────────────────────────┘

// Channel lines (breakout engine)
plot(useBreakoutEngine ? upperChannel : na, "Upper Channel", color=color.new(color.green, 60),
     linewidth=1, style=plot.style_stepline)
plot(useBreakoutEngine ? lowerChannel : na, "Lower Channel", color=color.new(color.red, 60),
     linewidth=1, style=plot.style_stepline)

// Trend EMAs
plot(useTrendFollowEngine ? emaFast : na, "Fast EMA", color=color.new(color.aqua, 30), linewidth=1)
plot(useTrendFollowEngine ? emaSlow : na, "Slow EMA", color=color.new(color.orange, 30), linewidth=2)

// Pullback EMA (entry zone for trend engine)
plot(useTrendFollowEngine ? emaPullback : na, "Pullback EMA", color=color.new(color.yellow, 50),
     linewidth=1, style=plot.style_circles)

// Stop-loss levels (color-coded per engine)
plot(boHasPosition ? boCurrentSL : na, "BO Stop Loss", color=color.new(color.red, 30),
     linewidth=1, style=plot.style_circles)
plot(tfHasPosition ? tfCurrentSL : na, "TF Stop Loss", color=color.new(color.fuchsia, 30),
     linewidth=2, style=plot.style_cross)

// Entry signals
plotshape(boCanEnter and boLongSignal, "BO Long", shape.triangleup,
          location.belowbar, color.green, size=size.small)
plotshape(boCanEnter and boShortSignal, "BO Short", shape.triangledown,
          location.abovebar, color.red, size=size.small)
plotshape(tfCanEnter and tfLongSignal, "TF Long", shape.diamond,
          location.belowbar, color.aqua, size=size.small)
plotshape(tfCanEnter and tfShortSignal, "TF Short", shape.diamond,
          location.abovebar, color.fuchsia, size=size.small)

// Background indicators
bgcolor(boCooldown > 0 or tfCooldown > 0 ? color.new(color.gray, 92) : na, title="Cooldown Zone")
bgcolor(not inSession ? color.new(color.orange, 95) : na, title="Out of Session")
bgcolor(dailyLossLimitHit ? color.new(color.red, 92) : na, title="Daily Loss Limit")

// Trend background (subtle)
trendBgColor = trendUp ? color.new(color.green, 96) : trendDown ? color.new(color.red, 96) : na
bgcolor(useTrendFollowEngine ? trendBgColor : na, title="Trend Direction")


// ┌─────────────────────────────────────────────────────────────────────────┐
// │                           INFO TABLE                                    │
// └─────────────────────────────────────────────────────────────────────────┘

var table infoTable = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80))

if barstate.islast
    row = 0

    table.cell(infoTable, 0, row, "ENGINE", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, row, "STATUS", text_color=color.white, text_size=size.small)
    row += 1

    // Breakout engine status
    boStatus = boHasPosition ? (boTrailActive ? "Trailing" : (boBEHit ? "Breakeven" : "Active")) : (boCooldown > 0 ? "Cooldown " + str.tostring(boCooldown) : "Ready")
    boColor  = boHasPosition ? color.green : (boCooldown > 0 ? color.orange : color.gray)
    table.cell(infoTable, 0, row, "Breakout", text_color=color.green, text_size=size.small)
    table.cell(infoTable, 1, row, boStatus, text_color=boColor, text_size=size.small)
    row += 1

    // Trend engine status
    tfStatus = tfHasPosition ? (tfTrailActive ? "Trailing" : (tfBEHit ? "Breakeven" : "Active")) : (tfCooldown > 0 ? "Cooldown " + str.tostring(tfCooldown) : "Ready")
    tfColor  = tfHasPosition ? color.aqua : (tfCooldown > 0 ? color.orange : color.gray)
    table.cell(infoTable, 0, row, "Trend", text_color=color.aqua, text_size=size.small)
    table.cell(infoTable, 1, row, tfStatus, text_color=tfColor, text_size=size.small)
    row += 1

    table.cell(infoTable, 0, row, "─────", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, row, "─────", text_color=color.gray, text_size=size.small)
    row += 1

    // ADX
    table.cell(infoTable, 0, row, "ADX", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, row, str.tostring(adxValue, "#.0"), text_color=adxOk ? color.green : color.red, text_size=size.small)
    row += 1

    // ATR
    table.cell(infoTable, 0, row, "ATR", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, row, str.tostring(atrValue, "#.00"), text_color=color.white, text_size=size.small)
    row += 1

    // Trend
    trendStr = trendUp ? "UP" : trendDown ? "DOWN" : "FLAT"
    trendClr = trendUp ? color.green : trendDown ? color.red : color.gray
    table.cell(infoTable, 0, row, "Trend", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, row, trendStr, text_color=trendClr, text_size=size.small)
    row += 1

    // Session
    table.cell(infoTable, 0, row, "Session", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, row, inSession ? "Active" : "Inactive", text_color=inSession ? color.green : color.orange, text_size=size.small)
    row += 1

    // Daily P&L
    table.cell(infoTable, 0, row, "Daily P&L", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, row, str.tostring(dailyPnL, "#.00"), text_color=dailyPnL >= 0 ? color.green : color.red, text_size=size.small)
    row += 1

    // BO Trail distance
    table.cell(infoTable, 0, row, "BO Trail", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, row, str.tostring(boTrailDistance, "#.0") + " ATR", text_color=color.green, text_size=size.small)
    row += 1

    // TF Trail distance
    table.cell(infoTable, 0, row, "TF Trail", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, row, str.tostring(tfTrailDistance, "#.0") + " ATR", text_color=color.aqua, text_size=size.small)
    row += 1

    // Positions
    table.cell(infoTable, 0, row, "Positions", text_color=color.white, text_size=size.small)
    posCount = (boHasPosition ? 1 : 0) + (tfHasPosition ? 1 : 0)
    table.cell(infoTable, 1, row, str.tostring(posCount) + " / 2", text_color=color.white, text_size=size.small)
