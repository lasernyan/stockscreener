//@version=6
strategy("Gold Dual MA Strategy (30/120) [Improved]", overlay=true,
     initial_capital=1000000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=5,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     slippage=1,
     calc_on_every_tick=false)

// --- Inputs ---
// Date Range
startDate = input.time(timestamp("2020-01-01 00:00"), "Start Date")
endDate   = input.time(timestamp("2030-01-01 00:00"), "End Date")

// MA Settings (fixed 30/120)
fastLen = input.int(30,  "Fast SMA Length", minval=1)
slowLen = input.int(120, "Slow SMA Length", minval=1)

// Risk Management
grp_risk    = "Risk Management"
useAtrSL    = input.bool(true,  "Use ATR Stop Loss",          group=grp_risk)
atrPeriod   = input.int(14,     "ATR Period",    minval=1,    group=grp_risk)
atrSlMult   = input.float(2.0,  "SL Multiplier (ATR)", minval=0.5, maxval=5.0, step=0.1, group=grp_risk)
atrTpMult   = input.float(4.0,  "TP Multiplier (ATR)", minval=1.0, maxval=10.0, step=0.1, group=grp_risk)

// Direction
grp_dir     = "Direction"
allowLong   = input.bool(true,  "Allow Long",  group=grp_dir)
allowShort  = input.bool(false, "Allow Short", group=grp_dir)

// --- Calculations ---
fastMA = ta.sma(close, fastLen)
slowMA = ta.sma(close, slowLen)
atrVal = ta.atr(atrPeriod)

// --- Plotting ---
plot(fastMA, "Fast SMA (30)",  color=color.blue)
plot(slowMA, "Slow SMA (120)", color=color.orange)

// --- Strategy Logic ---
inDateRange = time >= startDate and time <= endDate

// Cross signals
bullCross = ta.crossover(fastMA, slowMA)
bearCross = ta.crossunder(fastMA, slowMA)

// --- Execution ---
if inDateRange
    // === Long ===
    if allowLong and bullCross
        strategy.entry("Long", strategy.long)
        if useAtrSL
            slPrice = close - atrVal * atrSlMult
            tpPrice = close + atrVal * atrTpMult
            strategy.exit("Long Exit", "Long", stop=slPrice, limit=tpPrice)

    if bearCross
        strategy.close("Long", comment="Trend Reversal")

    // === Short ===
    if allowShort and bearCross
        strategy.entry("Short", strategy.short)
        if useAtrSL
            slPrice = close + atrVal * atrSlMult
            tpPrice = close - atrVal * atrTpMult
            strategy.exit("Short Exit", "Short", stop=slPrice, limit=tpPrice)

    if bullCross
        strategy.close("Short", comment="Trend Reversal")

// --- Close all positions outside date range ---
if not inDateRange
    strategy.close_all("Out of date range")
